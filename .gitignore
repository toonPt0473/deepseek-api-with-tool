# ===================================================
# 🔒 ข้อมูลความลับและเซสชัน (Security & Credentials)
# ห้ามขึ้น Git เด็ดขาดเพื่อความปลอดภัยของบัญชี
# ===================================================
.env
.env.local
.env.*.local
session/

# ===================================================
# 📦 ไลบรารีและ Dependencies
# ===================================================
node_modules/

# ===================================================
# 📜 ไฟล์บันทึกการทำงานและดีบัก (Logs)
# ===================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===================================================
# 🎭 Playwright & ผลการทดสอบ (Test Artifacts)
# ===================================================
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ===================================================
# 🖥️ ไฟล์ระบบปฏิบัติการ (macOS / Windows / Linux)
# ===================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================================================
# 💻 โปรแกรมเขียนโค้ดและ IDE (Editors)
# ===================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
