{
  "name": "deepseek-api-node",
  "version": "1.0.0",
  "description": "Unofficial OpenAI-compatible DeepSeek API bridge in Node.js with WebAssembly PoW solver, Playwright authentication, and Tool Calling emulation",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "accounts": "node cli.js account:list",
    "account:list": "node cli.js account:list",
    "account:add": "node cli.js account:add",
    "account:refresh": "node cli.js account:refresh",
    "account:remove": "node cli.js account:remove",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "deepseek",
    "llm",
    "openai-compatible",
    "tool-calling",
    "webassembly",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1"
  }
}
