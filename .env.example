# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Rate limit per minute per client IP
RATE_LIMIT_PER_MINUTE=30

# Allow server to open interactive browser window on first use if no session exists (1/0)
SERVER_INTERACTIVE_LOGIN=1

# Optional custom profile directory and session file path
# DEEPSEEK_PROFILE_DIR=./session/profile
# DEEPSEEK_SESSION_FILE=./session/session.json

# เปิดใช้งาน DeepThink (Reasoning) และ Web Search เป็นค่าเริ่มต้นทุกคำขอ (true/false)
DEFAULT_THINKING=false
DEFAULT_SEARCH=false

